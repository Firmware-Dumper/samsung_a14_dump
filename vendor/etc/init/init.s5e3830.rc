# IMS packet router daemon
#service pktrouter /system/bin/wfc-pkt-router
#    class core
#    user root
#    disabled
#    seclabel u:r:pktrouter:s0
#
#on property:init.svc.vendor.pktrouter=1
#    start pktrouter
#
#on property:init.svc.vendor.pktrouter=0
#    stop pktrouter

on property:sys.boot_completed=1
    start insmod_sh_common

service insmod_sh_common /vendor/bin/init.insmod.sh /vendor/etc/init.insmod.${ro.hardware}.cfg
    class main
    user root
    group root system
    disabled
    oneshot

# Sysscope
service prepare_param /system/bin/prepare_param.sh /dev/block/by-name/param
    class core
    user root
    group root
    seclabel u:r:prepare_param:s0
    oneshot

# SSWAP
on boot
    write /proc/sys/vm/swappiness 130

# Pageboostd
on property:sys.boot_completed=1
    start pageboostd

service pageboostd /system/bin/pageboostd
    class main
    user system
    group system mount radio net_bt sdcard_rw shell media media_rw
    socket pageboostd seqpacket 0660 system system
    disabled
